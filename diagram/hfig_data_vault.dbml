Table raw_vault.msat_client_address_gp_customer {
  client_hk BINARY(32) [pk, note: 'Foreign key to hub_client, hashed exactly as that table\'s own loader hashes it -- so the join holds by construction rather than by careful copying.; classification internal']
  hashdiff BINARY(32) [note: 'SHA-256 over this satellite\'s payload. Change detection: a new version is written only when this differs from the row before it, so an unchanged re-delivery costs nothing.; classification internal']
  mas_key source_derived [pk, note: 'The sub-key that makes a multi-active satellite\'s rows distinct within one parent and one load -- a skill code or phone type, in preference to a generated sequence.; classification internal; type read from the bound bronze column at load time, not declared in the model']
  adrscode source_derived [note: 'GP\'s address code -- BILL TO, SHIP TO, PRIMARY and the like. The multi-active sub-key: a customer holds several of these at once and none of them supersedes the others.; classification internal; type read from the bound bronze column at load time, not declared in the model']
  address1 source_derived [note: 'First line of the address as GP holds it. Unparsed.; classification internal; type read from the bound bronze column at load time, not declared in the model']
  address2 source_derived [note: 'Second line of the address as GP holds it. Unparsed, and frequently empty.; classification internal; type read from the bound bronze column at load time, not declared in the model']
  city source_derived [note: 'The city as GP holds it. Not reconciled against any reference list.; classification internal; type read from the bound bronze column at load time, not declared in the model']
  country source_derived [note: 'The country as GP holds it -- a free-text name, not an ISO code. Unlike sat_legal_entity_details.jurisdiction, nothing normalises this, so it is carried verbatim and any consumer wanting ISO must map it.; classification internal; type read from the bound bronze column at load time, not declared in the model']
  phone1 source_derived [note: 'The first of GP\'s phone numbers for this address slot.; classification internal; type read from the bound bronze column at load time, not declared in the model']
  cntcprsn source_derived [note: 'The named contact person at the customer for this address slot. A person\'s name at a company, recorded because the receivables process uses it; if the customer roster ever carries private individuals, this column is the reason to revisit the entity\'s sensitivity.; classification internal; type read from the bound bronze column at load time, not declared in the model']
  load_dts TIMESTAMP [pk, note: 'When WE learned this row, set by the load and monotonic within a run. Not when it happened in the source -- that is applied_dts.; classification internal']
  applied_dts TIMESTAMP [note: 'When this row\'s change happened in the SOURCE. May arrive late, and may be NULL where a feed ships no business clock. Type-2 end-dating runs on this, never on load_dts.; classification internal']
  sub_seq INT [pk, note: 'Intra-batch ordering, used only to break a tie when two rows share a load_dts. Carries no business meaning and is never a business key.; classification internal']
  rec_src STRING [note: 'Which feed delivered this row. Provenance, NOT identity -- never join on it. The source name is already hashed into a federated key, so joining on both would be asserting the same thing twice.; classification internal']
  batch_id STRING [note: 'The load run that wrote this row, for tracing a value back to the run that produced it.; classification internal']
  manifest_id STRING [note: 'The delivery manifest this row was approved under. Loop-1 reconciliation compares what a manifest approved against what landed and what was quarantined.; classification internal']
  cdc_op STRING [note: 'The change operation Bronze delivered: I, U or D. What the SOURCE said happened, not what this vault did with it.; classification internal']
  Note: 'msat in the party domain; declared sensitivity internal'
}

