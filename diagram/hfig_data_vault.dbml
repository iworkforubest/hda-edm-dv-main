  invoice_line_hk BINARY(32) [pk, note: 'Foreign key to nhl_invoice_line, hashed exactly as that table\'s own loader hashes it -- so the join holds by construction rather than by careful copying.; classification internal']
  hashdiff BINARY(32) [note: 'SHA-256 over this satellite\'s payload. Change detection: a new version is written only when this differs from the row before it, so an unchanged re-delivery costs nothing.; classification internal']
  description source_derived [note: 'AME004 -- invoice id, worker as Last First, week-ending and line ref, pipe delimited.; classification internal; type read from the bound bronze column at load time, not declared in the model']
  line_description source_derived [note: 'AME005 -- the same without the invoice id.; classification internal; type read from the bound bronze column at load time, not declared in the model']
  line_type source_derived [note: 'AME007 -- TAX where the source type is Tax, otherwise ITEM.; classification internal; type read from the bound bronze column at load time, not declared in the model']
  amount DECIMAL(18,2) [note: 'AME008 -- the line amount for an ITEM line, being the CLIENT amount: invoice_line_item_amount_client from the raw vault, which is the supplier cost plus that line\'s MSP margin. Not the supplier figure. Tax is aggregated onto the final TAX line and all lines sum to the invoice gross. Named `amount` because Ameren\'s template names the column `Amount`; the thirteen gold field names are the customer\'s contract and are not ours to rename. Masked by governance.mask_money.; classification financial; MASKED by governance.mask_money']
  invoice_amount DECIMAL(18,2) [note: 'AME003 -- the invoice gross, repeated on every line of the invoice, from sat_invoice_header.gross_invoice_amount. The reconciliation target. A DIFFERENT GRAIN FROM `amount` AND FROM THE RAW VAULT\'S LINE COLUMN: this is the whole invoice\'s value on every line, which is what Ameren\'s template asks for and what AME008 checks the lines against. The raw vault\'s per-line client amount is called invoice_line_item_amount_client precisely so that these two cannot be confused by a projection -- Spark resolves identifiers case-insensitively, so one name for two grains is either an AMBIGUOUS_REFERENCE or, worse, a silent pick. Masked by governance.mask_money.; classification financial; MASKED by governance.mask_money']
  accounting_date source_derived [note: 'AME009 -- from the week-ending date. See the open question on its format.; classification internal; type read from the bound bronze column at load time, not declared in the model']
  project_number source_derived [note: 'AME010 -- the source project code, unchanged.; classification internal; type read from the bound bronze column at load time, not declared in the model']
  task_number source_derived [note: 'AME011 -- the value after the pipe in the module\'s task code, trailing parenthesis removed. A code with no pipe yields the whole code rather than a blank.; classification internal; type read from the bound bronze column at load time, not declared in the model']
  expenditure_type source_derived [note: 'AME012 -- the expenditure type belonging to the line\'s module.; classification internal; type read from the bound bronze column at load time, not declared in the model']
  expenditure_organization source_derived [note: 'AME013 -- the expenditure organization belonging to the line\'s module.; classification internal; type read from the bound bronze column at load time, not declared in the model']
