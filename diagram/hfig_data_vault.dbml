Table raw_vault.sat_invoice_header_fieldglass_us {
  invoice_hk BINARY(32) [pk, note: 'Foreign key to hub_invoice, hashed exactly as that table\'s own loader hashes it -- so the join holds by construction rather than by careful copying.; classification internal']
  hashdiff BINARY(32) [note: 'SHA-256 over this satellite\'s payload. Change detection: a new version is written only when this differs from the row before it, so an unchanged re-delivery costs nothing.; classification internal']
  invoice_type source_derived [note: 'Fieldglass invoice type, IN in the sample. Retained because a credit note is a different document and must not be released as an invoice.; classification internal; type read from the bound bronze column at load time, not declared in the model']
  gross_invoice_amount DECIMAL(18,2) [note: 'The invoice total CHARGED TO THE CLIENT, inclusive of MSP margin and before tax. AME003 repeats this on every line and AME008 asserts the lines sum to it -- so this column is the reconciliation target, not a convenience copy. Settled 24 September 2026: the client total is what Ameren is invoiced, and the supplier total (gross_supplier_invoice_amount) is the underlying cost. The two differ by the MSP margin, measured at 24,054.04 across 380 of 419 invoices. Masked by governance.mask_money.; classification financial; MASKED by governance.mask_money']
  net_invoice_amount DECIMAL(18,2) [note: 'THE SOURCE\'S NAMES ARE INVERTED AND THIS IS THE LARGER FIGURE. Despite being called "net", this is the invoice total INCLUDING tax: measured across all 419 real invoices, net_invoice_amount = gross_invoice_amount + invoice_adjustment_amount, without exception. Independently confirmed by Amy Keser\'s `Ameren Invoice Value Analysis` of 24 September, which reaches the same reading from the client\'s own figures. The columns keep the source\'s spelling because the raw vault records what the source sent; this description is where the trap is named, because only 2 of the 419 invoices carry any tax, so on the other 417 the two columns are equal and the inversion is invisible. Masked by governance.mask_money.; classification financial; MASKED by governance.mask_money']
  currency source_derived [note: 'classification internal; type read from the bound bronze column at load time, not declared in the model']
  invoice_submit_date source_derived [note: 'classification internal; type read from the bound bronze column at load time, not declared in the model']
  original_invoice_id source_derived [note: 'Present when this invoice supersedes another. Carried so a reissue can be distinguished from a first issue, which the issuance ledger in Task 6 needs.; classification internal; type read from the bound bronze column at load time, not declared in the model']
  load_dts TIMESTAMP [pk, note: 'When WE learned this row, set by the load and monotonic within a run. Not when it happened in the source -- that is applied_dts.; classification internal']
  applied_dts TIMESTAMP [note: 'When this row\'s change happened in the SOURCE. May arrive late, and may be NULL where a feed ships no business clock. Type-2 end-dating runs on this, never on load_dts.; classification internal']
  sub_seq INT [pk, note: 'Intra-batch ordering, used only to break a tie when two rows share a load_dts. Carries no business meaning and is never a business key.; classification internal']
  rec_src STRING [note: 'Which feed delivered this row. Provenance, NOT identity -- never join on it. The source name is already hashed into a federated key, so joining on both would be asserting the same thing twice.; classification internal']
  batch_id STRING [note: 'The load run that wrote this row, for tracing a value back to the run that produced it.; classification internal']
  manifest_id STRING [note: 'The delivery manifest this row was approved under. Loop-1 reconciliation compares what a manifest approved against what landed and what was quarantined.; classification internal']
  cdc_op STRING [note: 'The change operation Bronze delivered: I, U or D. What the SOURCE said happened, not what this vault did with it.; classification internal']
  Note: 'sat in the pay_bill domain; declared sensitivity financial'
}

