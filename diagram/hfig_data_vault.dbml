Table raw_vault.sat_supplier_details_gp_vendor {
  supplier_hk BINARY(32) [pk, note: 'Foreign key to hub_supplier, hashed exactly as that table\'s own loader hashes it -- so the join holds by construction rather than by careful copying.; classification internal']
  hashdiff BINARY(32) [note: 'SHA-256 over this satellite\'s payload. Change detection: a new version is written only when this differs from the row before it, so an unchanged re-delivery costs nothing.; classification internal']
  vendname source_derived [note: 'The vendor\'s name as Great Plains holds it, within one company\'s books. Not a key and not reliable as one: 630 vendor ids carry different names in different operating companies, which is why the id is scoped rather than the name normalised.; classification internal; type read from the bound bronze column at load time, not declared in the model']
  venddba source_derived [note: 'The vendor\'s trading name -- "doing business as" -- where GP holds one. Frequently empty and frequently a different spelling of vendname rather than a different company.; classification internal; type read from the bound bronze column at load time, not declared in the model']
  vendshnm source_derived [note: 'GP\'s short name for the vendor. A display convenience, carried because it is what appears on some GP reports and a reconciliation against them needs it.; classification internal; type read from the bound bronze column at load time, not declared in the model']
  vendstts source_derived [note: 'GP\'s vendor status -- active, inactive, temporary, hold. Recorded and never filtered: a vendor on hold still owns payables history and must still resolve.; classification internal; type read from the bound bronze column at load time, not declared in the model']
  curncyid source_derived [note: 'The vendor\'s default currency code. An identifier, not an amount.; classification internal; type read from the bound bronze column at load time, not declared in the model']
  pymtrmid source_derived [note: 'The vendor\'s default payment terms code. An identifier, not an amount.; classification internal; type read from the bound bronze column at load time, not declared in the model']
  load_dts TIMESTAMP [pk, note: 'When WE learned this row, set by the load and monotonic within a run. Not when it happened in the source -- that is applied_dts.; classification internal']
  applied_dts TIMESTAMP [note: 'When this row\'s change happened in the SOURCE. May arrive late, and may be NULL where a feed ships no business clock. Type-2 end-dating runs on this, never on load_dts.; classification internal']
  sub_seq INT [pk, note: 'Intra-batch ordering, used only to break a tie when two rows share a load_dts. Carries no business meaning and is never a business key.; classification internal']
  rec_src STRING [note: 'Which feed delivered this row. Provenance, NOT identity -- never join on it. The source name is already hashed into a federated key, so joining on both would be asserting the same thing twice.; classification internal']
  batch_id STRING [note: 'The load run that wrote this row, for tracing a value back to the run that produced it.; classification internal']
  manifest_id STRING [note: 'The delivery manifest this row was approved under. Loop-1 reconciliation compares what a manifest approved against what landed and what was quarantined.; classification internal']
  cdc_op STRING [note: 'The change operation Bronze delivered: I, U or D. What the SOURCE said happened, not what this vault did with it.; classification internal']
  Note: 'sat in the party domain; declared sensitivity internal'
}

