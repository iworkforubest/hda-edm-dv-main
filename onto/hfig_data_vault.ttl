dv:invoiceLine_invoiceAmount rdf:type owl:DatatypeProperty ;
    rdfs:label "invoice amount" ;
    rdfs:comment "AME003 -- the invoice gross, repeated on every line of the invoice, from sat_invoice_header.gross_invoice_amount. The reconciliation target. A DIFFERENT GRAIN FROM `amount` AND FROM THE RAW VAULT'S LINE COLUMN: this is the whole invoice's value on every line, which is what Ameren's template asks for and what AME008 checks the lines against. The raw vault's per-line client amount is called invoice_line_item_amount_client precisely so that these two cannot be confused by a projection -- Spark resolves identifiers case-insensitively, so one name for two grains is either an AMBIGUOUS_REFERENCE or, worse, a silent pick. Masked by governance.mask_money." ;
    rdfs:domain dv:InvoiceLine ;
    rdfs:range xsd:decimal ;
    dv:sqlType "DECIMAL(18,2)" ;
    dv:classification "financial" ;
    dv:maskFunction "governance.mask_money" ;
    dv:sourceTable "csat_invoice_line_gie_rev1" .

