dv:client_cntcprsn rdf:type owl:DatatypeProperty ;
    rdfs:label "cntcprsn" ;
    rdfs:comment "The named contact person at the customer for this address slot. A person's name at a company, recorded because the receivables process uses it; if the customer roster ever carries private individuals, this column is the reason to revisit the entity's sensitivity." ;
    rdfs:domain dv:Client ;
    dv:typeUndeclared "true" ;
    dv:sqlType "source-derived" ;
    dv:classification "internal" ;
    dv:sourceTable "msat_client_address_gp_customer_rev1" .

dv:client_country rdf:type owl:DatatypeProperty ;
    rdfs:label "country" ;
    rdfs:comment "The country as GP holds it -- a free-text name, not an ISO code. Unlike sat_legal_entity_details.jurisdiction, nothing normalises this, so it is carried verbatim and any consumer wanting ISO must map it." ;
    rdfs:domain dv:Client ;
    dv:typeUndeclared "true" ;
    dv:sqlType "source-derived" ;
    dv:classification "internal" ;
    dv:sourceTable "msat_client_address_gp_customer_rev1" .

dv:client_curncyid rdf:type owl:DatatypeProperty ;
    rdfs:label "curncyid" ;
    rdfs:comment "The customer's default currency code. An identifier, not an amount." ;
