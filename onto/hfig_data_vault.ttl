    dv:sqlType "source-derived" ;
    dv:classification "internal" ;
    dv:sourceTable "sat_client_details_gp_customer_rev1" .

dv:client_custclas rdf:type owl:DatatypeProperty ;
    rdfs:label "custclas" ;
    rdfs:comment "GP's customer class -- VMS, GROUP FILL, TPV and others. Carried verbatim. Nothing in the raw vault decides what a class means; that reading belongs downstream where it can be changed without re-keying." ;
    rdfs:domain dv:Client ;
    dv:typeUndeclared "true" ;
    dv:sqlType "source-derived" ;
    dv:classification "internal" ;
    dv:sourceTable "sat_client_details_gp_customer_rev1" .

dv:client_custname rdf:type owl:DatatypeProperty ;
    rdfs:label "custname" ;
    rdfs:comment "The customer's name as Great Plains holds it. Spelling is not normalised and is not reliable as a key -- KCCA is \"KIMBERLY CLARK CANADA\" in one company database and \"Kimberly Clark Canada\" in another. The customer NUMBER is the identity." ;
    rdfs:domain dv:Client ;
    dv:typeUndeclared "true" ;
    dv:sqlType "source-derived" ;
    dv:classification "internal" ;
    dv:sourceTable "sat_client_details_gp_customer_rev1" .

dv:client_inactive rdf:type owl:DatatypeProperty ;
    rdfs:label "inactive" ;
    rdfs:comment "GP's inactive flag, set on real records in this extract. Recorded and never filtered: an inactive customer still owns receivables history and must still resolve." ;
    rdfs:domain dv:Client ;
    dv:typeUndeclared "true" ;
    dv:sqlType "source-derived" ;
    dv:classification "internal" ;
    dv:sourceTable "sat_client_details_gp_customer_rev1" .

dv:client_masKey rdf:type owl:DatatypeProperty ;
    rdfs:label "mas key" ;
    rdfs:comment "The sub-key that makes a multi-active satellite's rows distinct within one parent and one load -- a skill code or phone type, in preference to a generated sequence." ;
    rdfs:domain dv:Client ;
    dv:typeUndeclared "true" ;
    dv:sqlType "source-derived" ;
    dv:classification "internal" ;
    dv:sourceTable "msat_client_address_gp_customer_rev1" .

